table *QoQ
	lineageTag: 0ee15ec2-1fcc-4b65-9986-3edc4891c725

	measure Profit_QoQ_Label =
			
			VAR q2 =
			    CALCULATE(
			        [M_profit],
			        FILTER(
			            ALL('dim_calendar'),
			            'dim_calendar'[Date] >= DATE(2024,4,1) &&
			            'dim_calendar'[Date] <= DATE(2024,6,30)
			        )
			    )
			
			VAR q3 =
			    CALCULATE(
			        [M_profit],
			        FILTER(
			            ALL('dim_calendar'),
			            'dim_calendar'[Date] >= DATE(2024,7,1) &&
			            'dim_calendar'[Date] <= DATE(2024,9,30)
			        )
			    )
			
			VAR change =
			    IF(
			        NOT ISBLANK(q2) && q2 <> 0,
			        DIVIDE(q3 - q2, q2)
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(q2) && NOT ISBLANK(q3),
			    "Q2: " & FORMAT(q2 / 1000000, "0.0") & "M" &
			    " | Q3: " & FORMAT(q3 / 1000000, "0.0") & "M" &
			    " (" & FORMAT(change, "0%") &
			    IF(change > 0, " ▲", " ▼") & ")"
			)
		lineageTag: 637376da-979d-4dce-822e-735a4f639a57

