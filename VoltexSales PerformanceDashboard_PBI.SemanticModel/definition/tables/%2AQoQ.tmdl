	measure PM_QoQ_Label =
			
			VAR q2 =
			    CALCULATE(
			        [M_profit margin],
			        FILTER(
			            ALL('dim_calendar'),
			            'dim_calendar'[Date] >= DATE(2024,4,1) &&
			            'dim_calendar'[Date] <= DATE(2024,6,30)
			        )
			    )
			
			VAR q3 =
			    CALCULATE(
			        [M_profit margin],
			        FILTER(
			            ALL('dim_calendar'),
			            'dim_calendar'[Date] >= DATE(2024,7,1) &&
			            'dim_calendar'[Date] <= DATE(2024,9,30)
			        )
			    )
			
			VAR change_pp = (q3 - q2) * 100
			
			VAR arrow =
			    IF(change_pp > 0, " ▲", " ▼")
			
			RETURN
			IF(
			    NOT ISBLANK(q2) && NOT ISBLANK(q3),
			    "Q2: " & FORMAT(q2, "0.0%") &
			    " | Q3: " & FORMAT(q3, "0.0%") &
			    " (" & FORMAT(change_pp, "0.0") & "pp" & arrow & ")"
			)
		lineageTag: de7f9cfb-3075-4f0d-ae97-023e8f8af760

