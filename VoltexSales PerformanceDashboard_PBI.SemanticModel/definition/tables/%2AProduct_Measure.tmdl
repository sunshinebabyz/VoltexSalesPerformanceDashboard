		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition *Product_Measure = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 897b953ebde5420da681bde5578e72da

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

