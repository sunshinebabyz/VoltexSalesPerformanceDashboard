table *Product_Measure
	lineageTag: 7a03bd11-01b5-4c34-b533-fafb020a1b50

	measure M_UnitSold = SUM(fact_order[Quantity])
		formatString: 0
		lineageTag: 1e17e418-881d-4940-a504-67f1b7166ed1

	measure M_AverageRating = AVERAGE(fact_order[Feedback_Rating])
		lineageTag: 6e567010-9344-40ca-9e34-7460fe0890cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
