table MOM
	lineageTag: 752bb1be-d130-468e-a794-c397bccac9cc

	measure MOM_profit_kpi =
			
			-- bước 1: xác định current và previous month
			VAR current_month = MAX(dim_calendar[Date])
			VAR previous_month = EOMONTH(current_month, -1) -- trả về ngày cuối cùng tháng trước
			
			-- bước 2: Doanh thu cho từng biến trên
			VAR revenue_current =
			    CALCULATE(
			        [M_profit],
			        FILTER(
			            dim_calendar,
			            dim_calendar[Year] = YEAR(current_month)
			            && MONTH(dim_calendar[Date]) = MONTH(current_month)
			        )
			    )
			
			VAR revenue_pre =
			    CALCULATE(
			        [M_profit],
			        FILTER(
			            ALL(dim_calendar),
			            dim_calendar[Year] = YEAR(previous_month)
			            && MONTH(dim_calendar[Date]) = MONTH(previous_month)
			        )
			    )
			
			RETURN
			DIVIDE(revenue_current - revenue_pre, revenue_pre)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9ad6e3ba-6e8a-4016-99b7-d9719ae469c8

	measure MOM_revenue_kpi =
			
