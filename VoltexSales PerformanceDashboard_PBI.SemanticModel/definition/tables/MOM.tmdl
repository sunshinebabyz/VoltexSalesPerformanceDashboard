	measure MOM_total_customers_kpi = ```
			
			-- bước 1: xác định current và previous month
			VAR current_month = MAX(dim_calendar[Date])
			VAR previous_month = EOMONTH(current_month, -1)
			
			-- bước 2: Customers từng tháng
			VAR customers_current =
			    CALCULATE(
			        [M_total customers],
			        FILTER(
			            dim_calendar,
			            dim_calendar[Year] = YEAR(current_month)
			            && MONTH(dim_calendar[Date]) = MONTH(current_month)
			        )
			    )
			
			VAR customers_pre =
			    CALCULATE(
			        [M_total customers],
			        FILTER(
			            ALL(dim_calendar),
			            dim_calendar[Year] = YEAR(previous_month)
			            && MONTH(dim_calendar[Date]) = MONTH(previous_month)
			        )
			    )
			
			RETURN
			DIVIDE(customers_current - customers_pre, customers_pre) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 41586325-9b94-471d-90dd-1b6a1958fa9e

	measure MOM_avg_revenue_per_customer_kpi =
			
			-- bước 1: xác định current và previous month
			VAR current_month = MAX(dim_calendar[Date])
			VAR previous_month = EOMONTH(current_month, -1)
			
			-- bước 2: Avg Revenue per Customer từng tháng
			VAR arpc_current =
			    CALCULATE(
			        [Avg Revenue per Customer],
			        FILTER(
			            dim_calendar,
			            dim_calendar[Year] = YEAR(current_month)
			            && MONTH(dim_calendar[Date]) = MONTH(current_month)
			        )
			    )
			
			VAR arpc_pre =
			    CALCULATE(
			        [Avg Revenue per Customer],
			        FILTER(
			            ALL(dim_calendar),
			            dim_calendar[Year] = YEAR(previous_month)
			            && MONTH(dim_calendar[Date]) = MONTH(previous_month)
			        )
			    )
			
			RETURN
			DIVIDE(arpc_current - arpc_pre, arpc_pre)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 72d969fe-151b-41be-a57b-6ef1cdfda822

	measure MOM_repeat_customer_rate_kpi =
			
			-- bước 1: xác định current và previous month
			VAR current_month = MAX(dim_calendar[Date])
			VAR previous_month = EOMONTH(current_month, -1)
			
			-- bước 2: Repeat Customer Rate từng tháng
			VAR rate_current =
			    CALCULATE(
